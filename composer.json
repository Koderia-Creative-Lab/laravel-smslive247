{
    "name": "koderia-creative-lab/laravel-smslive247",
    "description": "A modern Laravel client and Notification Channel driver for the SMSLive247 SMS Gateway.",
    "keywords": [
        "laravel",
        "sms",
        "smslive247",
        "nigeria",
        "notifications",
        "sms-gateway",
        "telecom"
    ],
    "homepage": "https://github.com/Koderia-Creative-Lab/laravel-smslive247",
    "license": "MIT",
    "authors": [
        {
            "name": "Koderia Creative Lab",
            "email": "iconcept573@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0",
        "illuminate/notifications": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Koderia\\SmsLive247\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koderia\\SmsLive247\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Koderia\\SmsLive247\\SmsLive247ServiceProvider"
            ],
            "aliases": {
                "SmsLive247": "Koderia\\SmsLive247\\Facades\\SmsLive247"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
